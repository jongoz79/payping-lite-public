{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paypingmy.app/parser-library/schema.json",
  "title": "PayPing parser rules",
  "description": "All match and extract expressions are portable regexes: no lookbehind and no JavaScript-only flags or constructs. Named groups use (?<name>…). Engines apply match expressions case-insensitively and require every listed field to match. Extract expressions run against the normalised body first, then the title, and use the named group corresponding to each extraction key.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "version", "androidPackages", "iosAppNames", "rules"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "author": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "androidPackages": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "iosAppNames": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "portableRegex": {
      "type": "string",
      "minLength": 1,
      "description": "Portable regex supported by TypeScript, Kotlin and Swift. No lookbehind, JavaScript-only flags, or duplicate named groups. Named groups use (?<name>…)."
    },
    "extraction": {
      "anyOf": [
        { "$ref": "#/$defs/portableRegex" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["pattern"],
          "properties": {
            "pattern": { "$ref": "#/$defs/portableRegex" },
            "source": { "type": "string", "enum": ["body", "title", "bodyThenTitle"] }
          }
        }
      ]
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "title": { "$ref": "#/$defs/portableRegex" },
        "body": { "$ref": "#/$defs/portableRegex" }
      }
    },
    "extract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "amount": { "$ref": "#/$defs/extraction" },
        "counterparty": { "$ref": "#/$defs/extraction" },
        "reference": { "$ref": "#/$defs/extraction" }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "priority", "match", "direction"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*\\.[a-z0-9-]+\\.v[0-9]+$"
        },
        "priority": { "type": "integer" },
        "match": { "$ref": "#/$defs/match" },
        "direction": { "type": "string", "enum": ["in", "out", "info"] },
        "confidence": { "type": "string", "enum": ["high", "none"] },
        "extract": { "$ref": "#/$defs/extract" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "direction": { "enum": ["in", "out"] } },
            "required": ["direction"]
          },
          "then": {
            "required": ["extract"],
            "properties": {
              "extract": {
                "type": "object",
                "required": ["amount"],
                "properties": { "amount": true }
              }
            }
          }
        }
      ]
    }
  }
}
