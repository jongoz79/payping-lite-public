{
  "schemaVersion": 1,
  "id": "rhb",
  "name": "RHB Mobile Banking",
  "version": 1,
  "description": "Synthetic starter patterns; not yet validated against real notifications.",
  "androidPackages": ["com.rhbgroup.rhbmobilebanking"],
  "iosAppNames": ["RHB Mobile Banking"],
  "rules": [
    {
      "id": "rhb.received-title.v1",
      "priority": 200,
      "match": { "title": "received|credited|incoming" },
      "direction": "in",
      "extract": {
        "amount": "-?\\s?(?:RM|MYR)\\s?-?\\s?(?<amount>[\\d,]+\\.?\\d{0,2})",
        "counterparty": "(?:received from|from) (?<counterparty>.+?)(?: for| on| ref|\\.|$)",
        "reference": "(?:(?:ref|reference) no\\.?|ref|reference)\\s?:?\\s?(?<reference>[A-Z0-9]+)"
      }
    },
    {
      "id": "rhb.received-body.v1",
      "priority": 190,
      "match": { "body": "received from|money received|credited to your account|transferred to you" },
      "direction": "in",
      "extract": {
        "amount": "-?\\s?(?:RM|MYR)\\s?-?\\s?(?<amount>[\\d,]+\\.?\\d{0,2})",
        "counterparty": "(?:received from|from) (?<counterparty>.+?)(?: for| on| ref|\\.|$)",
        "reference": "(?:(?:ref|reference) no\\.?|ref|reference)\\s?:?\\s?(?<reference>[A-Z0-9]+)"
      }
    },
    {
      "id": "rhb.sent-title.v1",
      "priority": 180,
      "match": { "title": "payment|paid|transfer|debit" },
      "direction": "out",
      "extract": {
        "amount": "-?\\s?(?:RM|MYR)\\s?-?\\s?(?<amount>[\\d,]+\\.?\\d{0,2})",
        "counterparty": "(?:(?:paid|transferred) to|to) (?<counterparty>.+?)(?: on| ref|\\.|$)",
        "reference": "(?:(?:ref|reference) no\\.?|ref|reference)\\s?:?\\s?(?<reference>[A-Z0-9]+)"
      }
    },
    {
      "id": "rhb.sent-body.v1",
      "priority": 170,
      "match": { "body": "paid to|transferred to|deducted from|debited|payment successful|transfer successful" },
      "direction": "out",
      "extract": {
        "amount": "-?\\s?(?:RM|MYR)\\s?-?\\s?(?<amount>[\\d,]+\\.?\\d{0,2})",
        "counterparty": "(?:(?:paid|transferred) to|to) (?<counterparty>.+?)(?: on| ref|\\.|$)",
        "reference": "(?:(?:ref|reference) no\\.?|ref|reference)\\s?:?\\s?(?<reference>[A-Z0-9]+)"
      }
    }
  ]
}
